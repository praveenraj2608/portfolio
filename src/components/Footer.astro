---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <p class="mono muted">&copy; {year} {profile.name}</p>
    <p class="mono muted">Built with Astro + GSAP. Hosted on Cloudflare Pages.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
</style>
