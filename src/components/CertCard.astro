---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  cert: CollectionEntry<'certifications'>;
  index: number;
  showImage?: boolean;
}

const { cert, index, showImage = true } = Astro.props;
const { name, issuer, date, image, credentialUrl } = cert.data;

// Certificate files dropped into src/assets/certificates/ are picked up here.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/certificates/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = image ? files[`../assets/certificates/${image}`]?.default : undefined;
const num = String(index + 1).padStart(2, '0');
---

<article class="cert" data-reveal>
  {
    showImage && (
      <div class="media">
        {img ? (
          <Image src={img} alt={`${name} certificate issued by ${issuer}`} widths={[480, 800]} sizes="(max-width: 768px) 92vw, 45vw" />
        ) : (
          <div class="empty">
            <Icon name="certificate" class="empty-icon" />
            <p class="mono muted">Certificate image to be added</p>
          </div>
        )}
      </div>
    )
  }
  <div class="info">
    <div class="row mono muted">
      <span>{num}</span>
      <span>{date ?? 'Completed'}</span>
    </div>
    <h3 class="name">{name}</h3>
    <p class="muted">{issuer}</p>
    {
      credentialUrl && (
        <a class="verify" href={credentialUrl} target="_blank" rel="noopener">
          Verify credential <Icon name="arrow-up-right" />
        </a>
      )
    }
  </div>
</article>

<style>
  .cert {
    display: grid;
    gap: 20px;
    padding: 12px 12px 24px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: var(--surface);
    height: 100%;
  }

  .media {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    aspect-ratio: 1.414 / 1;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .empty {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    margin: 10px;
    height: calc(100% - 20px);
    text-transform: none;
    text-align: center;
  }

  .empty :global(.empty-icon) {
    width: 42px;
    height: 42px;
    color: var(--accent);
  }

  .info {
    display: grid;
    gap: 8px;
    padding-inline: 12px;
  }

  .row {
    display: flex;
    justify-content: space-between;
  }

  .name {
    margin-top: 6px;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .verify {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--accent);
  }

  .verify :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
