---
// Illustrated cover per project: a small diagram of how the project works,
// instead of a fake screenshot.
interface Props {
  id: string;
}
const { id } = Astro.props;
const bars = [38, 52, 46, 71, 64, 83, 58, 91, 77, 62, 49, 68];
const wave = [14, 28, 44, 22, 60, 36, 72, 30, 52, 18, 40, 66, 26, 48, 20, 56, 34, 62, 24, 42];
---

<div class="art" data-parallax>
  {
    id === 'environmental-impact-assessment' && (
      <svg viewBox="0 0 400 300" class="svg" aria-hidden="true">
        <g class="grid-lines">
          {[60, 110, 160, 210].map((y) => (
            <line x1="32" x2="368" y1={y} y2={y} />
          ))}
        </g>
        {bars.map((h, i) => (
          <rect class="bar" style={`--i:${i}`} x={40 + i * 27} y={240 - h * 1.9} width="15" height={h * 1.9} rx="3" />
        ))}
        <polyline class="trend" points={bars.map((h, i) => `${47 + i * 27},${232 - h * 1.9}`).join(' ')} />
        <g class="tag">
          <rect x="250" y="34" width="118" height="34" rx="17" />
          <circle cx="268" cy="51" r="5" />
          <text x="282" y="56">RISK 0-100</text>
        </g>
      </svg>
    )
  }
  {
    id === 'crewai-research-agent' && (
      <svg viewBox="0 0 400 300" class="svg" aria-hidden="true">
        <path class="link" d="M90 150 C 140 70, 180 70, 200 110" />
        <path class="link" d="M200 190 C 220 230, 260 230, 310 150" />
        <path class="link dash" d="M90 150 L 310 150" />
        {[
          { x: 90, y: 150, t: 'RESEARCH' },
          { x: 200, y: 150, t: 'ANALYST' },
          { x: 310, y: 150, t: 'WRITER' },
        ].map((n, i) => (
          <g class="node" style={`--i:${i}`}>
            <circle class="halo" cx={n.x} cy={n.y} r="38" />
            <circle class="core" cx={n.x} cy={n.y} r="26" />
            <text x={n.x} y={n.y + 62} text-anchor="middle">
              {n.t}
            </text>
          </g>
        ))}
        <g class="doc">
          <rect x="286" y="42" width="48" height="60" rx="5" />
          <line x1="296" x2="324" y1="58" y2="58" />
          <line x1="296" x2="318" y1="68" y2="68" />
          <line x1="296" x2="322" y1="78" y2="78" />
        </g>
      </svg>
    )
  }
  {
    id === 'voice-mock-interview-bot' && (
      <svg viewBox="0 0 400 300" class="svg" aria-hidden="true">
        {wave.map((h, i) => (
          <rect class="wave" style={`--i:${i}`} x={46 + i * 16} y={150 - h} width="8" height={h * 2} rx="4" />
        ))}
        <g class="tag">
          <rect x="32" y="34" width="132" height="34" rx="17" />
          <circle cx="50" cy="51" r="5" />
          <text x="64" y="56">LISTENING...</text>
        </g>
      </svg>
    )
  }
</div>

<style>
  .art {
    position: absolute;
    inset: -8% 0;
    display: grid;
    place-items: center;
  }

  .svg {
    width: 86%;
    height: auto;
    overflow: visible;
  }

  text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--muted);
    letter-spacing: 0.06em;
  }

  .grid-lines line {
    stroke: var(--line);
    stroke-dasharray: 3 5;
  }

  .bar {
    fill: color-mix(in srgb, var(--accent) 30%, var(--surface-2));
    transform-box: fill-box;
    transform-origin: bottom;
    animation: rise 3.6s var(--ease) infinite alternate;
    animation-delay: calc(var(--i) * 0.12s);
  }

  .bar:nth-child(8n) {
    fill: var(--accent);
  }

  .trend {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .tag rect {
    fill: var(--bg);
    stroke: var(--line);
  }

  .tag circle {
    fill: var(--accent);
    animation: pulse 1.8s ease-in-out infinite;
  }

  .tag text {
    fill: var(--text);
  }

  .link {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .dash {
    stroke: var(--accent);
    stroke-dasharray: 4 8;
    animation: flow 1.6s linear infinite;
  }

  .halo {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 45%, transparent);
    transform-box: fill-box;
    transform-origin: center;
    animation: ping 2.4s var(--ease) infinite;
    animation-delay: calc(var(--i) * 0.8s);
  }

  .core {
    fill: var(--surface-2);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .doc rect {
    fill: var(--surface-2);
    stroke: var(--line);
  }

  .doc line {
    stroke: var(--muted);
  }

  .wave {
    fill: color-mix(in srgb, var(--accent) 55%, var(--surface-2));
    transform-box: fill-box;
    transform-origin: center;
    animation: talk 1.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.09s);
  }

  @keyframes rise {
    from {
      transform: scaleY(0.55);
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  @keyframes ping {
    0% {
      transform: scale(0.7);
      opacity: 1;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @keyframes talk {
    from {
      transform: scaleY(0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .tag circle,
    .dash,
    .halo,
    .wave {
      animation: none;
    }
  }
</style>
