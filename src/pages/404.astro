---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found - Praveen Raj S" description="This page does not exist.">
  <section class="wrap nf">
    <p class="mono label"><b>404</b> Off the trail</p>
    <h1 class="title">This path leads nowhere.</h1>
    <a href="/" class="btn btn--solid">Back to the homepage <Icon name="arrow-right" /></a>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 70dvh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 28px;
  }

  .title {
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    max-width: 14ch;
  }
</style>
