---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div>
      <p class="mono label" data-reveal><b>05</b> Contact</p>
      <h2 id="contact-title" class="big" data-reveal>
        Have a role, a project or an idea? <span class="accent">Let's talk.</span>
      </h2>
    </div>

    <div class="links">
      <a class="link" href={`mailto:${profile.email}`} data-reveal>
        <Icon name="mail" />
        <span>
          <span class="mono muted">Email</span>
          <span class="val">{profile.email}</span>
        </span>
        <Icon name="arrow-up-right" class="go" />
      </a>
      <a class="link" href={profile.linkedin} target="_blank" rel="noopener" data-reveal>
        <Icon name="linkedin" />
        <span>
          <span class="mono muted">LinkedIn</span>
          <span class="val">in/praveenraj2608</span>
        </span>
        <Icon name="arrow-up-right" class="go" />
      </a>
      <a class="link" href={profile.github} target="_blank" rel="noopener" data-reveal>
        <Icon name="github" />
        <span>
          <span class="mono muted">GitHub</span>
          <span class="val">praveenraj2608</span>
        </span>
        <Icon name="arrow-up-right" class="go" />
      </a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(40px, 7vw, 120px);
    align-items: end;
  }

  .big {
    margin-top: 22px;
    font-size: clamp(2.4rem, 6vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.98;
    max-width: 14ch;
  }

  .accent {
    color: var(--accent);
  }

  .links {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .link {
    display: grid;
    grid-template-columns: 24px 1fr 20px;
    align-items: center;
    gap: 18px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
    transition: color 0.3s var(--ease);
  }

  .link > span {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .val {
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }

  .link :global(svg) {
    width: 22px;
    height: 22px;
  }

  .link :global(.go) {
    width: 18px;
    height: 18px;
    color: var(--muted);
    transition:
      transform 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .link:hover :global(.go) {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
