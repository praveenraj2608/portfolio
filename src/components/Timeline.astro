---
import { timeline } from '../data/profile';
---

<section id="experience" class="section" aria-labelledby="exp-title">
  <div class="wrap grid">
    <div>
      <p class="mono label" data-reveal><b>03</b> Experience &amp; wins</p>
      <h2 id="exp-title" class="section-title" data-reveal>Shipped for a client. <em>Won on stage.</em></h2>
    </div>

    <div class="list" data-timeline>
      <svg class="rail" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 2 100">
        <line x1="1" y1="0" x2="1" y2="100" class="rail-bg" />
        <line x1="1" y1="0" x2="1" y2="100" class="rail-fg" data-rail pathLength="1" />
      </svg>
      <ol class="items">
      {
        timeline.map((t) => (
          <li class="item" data-reveal>
            <span class="node" aria-hidden="true" />
            <div class="row mono">
              <span class="kind">{t.kind}</span>
              <span class="muted">{t.date}</span>
            </div>
            <h3 class="title">{t.title}</h3>
            <p class="muted">{t.org}</p>
            {t.points && (
              <ul class="points">
                {t.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 7vw, 120px);
  }

  .list {
    position: relative;
    padding-left: 40px;
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail {
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    height: calc(100% - 16px);
    overflow: visible;
  }

  .rail line {
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .rail-bg {
    stroke: var(--line);
  }

  .rail-fg {
    stroke: var(--accent);
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .item {
    position: relative;
    padding-block: 26px;
    border-top: 1px solid var(--line);
  }

  .item:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .node {
    position: absolute;
    left: -45px;
    top: 32px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .item:first-of-type .node {
    top: 6px;
  }

  .row {
    display: flex;
    gap: 16px;
  }

  .kind {
    color: var(--accent);
  }

  .title {
    margin-top: 12px;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .item > p {
    margin-top: 6px;
  }

  .points {
    margin: 14px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    max-width: 60ch;
  }

  .points li::marker {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
