---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CertCard from '../components/CertCard.astro';

const certs = await getCollection('certifications');
// Two staggered columns (masonry feel); the right column starts lower.
const columns = [0, 1].map((col) => certs.map((c, i) => ({ c, i })).filter(({ i }) => i % 2 === col));
---

<BaseLayout
  title="Certifications - Praveen Raj S"
  description="Certifications earned by Praveen Raj S across cloud, AI agents, Claude and Python."
>
  <section class="wrap intro">
    <p class="mono label" data-hero-fade><b>{String(certs.length).padStart(2, '0')}</b> Certifications</p>
    <h1 class="title">
      <span class="line"><span class="line-inner" data-hero-line>Proof of</span></span>
      <span class="line"><span class="line-inner" data-hero-line>the <span class="muted">homework.</span></span></span>
    </h1>
    <p class="lead muted" data-hero-fade>
      Courses I finished to go deeper on cloud fundamentals, AI agents, working with Claude, and Python.
    </p>
  </section>

  <section class="wrap grid-wrap" aria-label="Certificates">
    <div class="grid">
      {
        columns.map((col, k) => (
          <div class:list={['col', { 'col--offset': k === 1 }]}>
            {col.map(({ c, i }) => (
              <div style={`order:${i}`}>
                <CertCard cert={c} index={i} />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(48px, 8vw, 110px);
  }

  .title {
    margin-top: 22px;
    font-size: clamp(3rem, 9vw, 7.4rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .line-inner {
    display: block;
  }

  .lead {
    margin-top: 26px;
    max-width: 48ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .grid-wrap {
    padding-block: clamp(56px, 8vw, 110px) clamp(80px, 12vw, 160px);
  }

  /* Asymmetric two-column grid: right column starts lower */
  .grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }

  .col {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
  }

  .col--offset {
    padding-top: clamp(60px, 10vw, 160px);
  }

  @media (max-width: 800px) {
    /* Flatten the columns so cards read 01, 02, 03, 04 */
    .grid {
      grid-template-columns: 1fr;
    }
    .col {
      display: contents;
    }
  }
</style>
